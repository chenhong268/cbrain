{
  "name": "cbrain",
  "version": "2.0.4",
  "description": "Your Agent's Memory, Compounding. Agent 的记忆，复利生长。",
  "type": "module",
  "bin": {
    "cbrain": "./src/cli/index.ts"
  },
  "files": [
    "src/",
    "!src/**/*.test.ts",
    "!src/**/__tests__/**",
    "skills/",
    "bin/check-install-smoke.sh",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "bun run src/cli/index.ts",
    "test": "bun test",
    "test:coverage": "bun test --coverage",
    "typecheck": "tsc --noEmit",
    "typecheck:tests": "tsc --noEmit -p tsconfig.test.json",
    "lint": "bun run typecheck && bun run typecheck:tests && biome lint ./src ./tests",
    "check": "bun run lint && bun test",
    "check:install-network": "bun bin/check-install-network.ts",
    "check:install-tag": "bash bin/check-install-smoke.sh",
    "gate:offline": "bun bin/check-first-recall-gate.ts",
    "gate:rc": "bun bin/check-v2-rc-gate.ts",
    "gate:perf": "bun bin/check-v2-rc-gate.ts --perf",
    "gate:hermes": "bun bin/check-v2-hermes-gate.ts",
    "gate:v2-preflight": "bun bin/check-v2-preflight.ts",
    "gate:consistency": "bun bin/check-consistency-gate.ts",
    "check:docs": "bun bin/check-docs-consistency.ts"
  },
  "dependencies": {
    "@lancedb/lancedb": "^0.27.0",
    "@modelcontextprotocol/sdk": "^1.12.0",
    "apache-arrow": "^18.1.0",
    "commander": "^13.0.0",
    "gray-matter": "^4.0.3",
    "p-limit": "^7.3.0",
    "yaml": "^2.7.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.15",
    "@types/bun": "^1.2.0",
    "typescript": "^5.7.0"
  },
  "license": "MIT"
}
