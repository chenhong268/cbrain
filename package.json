{
  "name": "cbrain",
  "version": "1.9.1",
  "description": "Your Agent's Memory, Compounding. Agent 的记忆，复利生长。",
  "type": "module",
  "bin": {
    "cbrain": "./src/cli/index.ts"
  },
  "scripts": {
    "dev": "bun run src/cli/index.ts",
    "test": "bun test",
    "test:coverage": "bun test --coverage",
    "typecheck": "tsc --noEmit",
    "typecheck:tests": "tsc --noEmit -p tsconfig.test.json",
    "lint": "bun run typecheck && bun run typecheck:tests && biome lint ./src ./tests",
    "check": "bun run lint && bun test"
  },
  "dependencies": {
    "@lancedb/lancedb": "^0.27.0",
    "@modelcontextprotocol/sdk": "^1.12.0",
    "commander": "^13.0.0",
    "gray-matter": "^4.0.3",
    "p-limit": "^7.3.0",
    "yaml": "^2.7.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.15",
    "@types/bun": "^1.2.0",
    "typescript": "^5.7.0"
  },
  "license": "MIT"
}
