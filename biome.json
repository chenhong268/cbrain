{
	"$schema": "https://biomejs.dev/schemas/2.4.15/schema.json",
	"assist": { "actions": { "source": { "organizeImports": "off" } } },
	"linter": {
		"enabled": true,
		"rules": {
			"recommended": true,
			"correctness": {
				"noUnusedVariables": "error",
				"noUnusedImports": "warn"
			},
			"suspicious": {
				"noExplicitAny": "off"
			},
			"style": {
				"noNonNullAssertion": "off",
				"useConst": "error",
				"useImportType": "off",
				"useExportType": "off",
				"useTemplate": "off",
				"useNodejsImportProtocol": "off"
			},
			"complexity": {
				"useOptionalChain": "off",
				"useLiteralKeys": "off"
			}
		}
	},
	"files": {
		"includes": [
			"**",
			"!**/node_modules",
			"!**/dist",
			"!**/*.db",
			"!**/*.db-wal",
			"!**/*.db-shm",
			"!**/bench-*.ts"
		]
	},
	"javascript": {
		"globals": ["Bun"]
	}
}
